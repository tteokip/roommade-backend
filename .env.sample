# 이 파일을 .env 로 복사한 뒤 사용하세요.
# cp .env.sample .env
#
# docker-compose.yml이 MYSQL_* 값으로 로컬 MySQL 컨테이너를 만듭니다.
# appRun은 DB_* 값을 우선 사용하며, DB_*가 없으면 MYSQL_* 값으로 로컬 접속 정보를 만듭니다.

MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=roommade
MYSQL_USER=roommade
MYSQL_PASSWORD=roommade1234
MYSQL_PORT=3306

# 애플리케이션 DB 접속 정보입니다. 운영 환경에서는 이 값을 Tomcat 프로세스 환경 변수로 주입합니다.
# 로컬에서 MYSQL_*와 다른 DB에 연결해야 할 때만 값을 명시합니다.
# DB_JDBC_URL=jdbc:mysql://localhost:3306/roommade?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=roommade
# DB_PASSWORD=roommade1234
# DB_JDBC_DRIVER=com.mysql.cj.jdbc.Driver
# DB_POOL_MAXIMUM_SIZE=10
# DB_POOL_MINIMUM_IDLE=2
# DB_POOL_CONNECTION_TIMEOUT_MS=30000

# 매물 이미지 분석 API를 사용할 때만 입력합니다.
OPENAI_API_KEY=

# 매물 통근시간 계산 API를 사용할 때만 입력합니다.
TMAP_API_KEY=
