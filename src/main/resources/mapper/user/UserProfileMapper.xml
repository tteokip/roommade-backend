<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.roommade.domain.user.mapper.UserProfileMapper">
    <select id="findPolicyProfileByUserId"
            resultType="com.roommade.domain.user.dto.response.UserPolicyProfileResponse">
        SELECT name,
               birth_date,
               monthly_income
        FROM user_profiles
        WHERE user_id = #{userId}
    </select>
</mapper>
