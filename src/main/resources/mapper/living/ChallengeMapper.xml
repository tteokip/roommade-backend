<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.roommade.domain.living.mapper.ChallengeMapper">

    <select id="findAllLevels" resultType="com.roommade.domain.living.dto.response.ChallengeLevelResponse">
        SELECT
            level,
            max_spending AS maxSpending,
            reward_coin AS rewardCoin
        FROM challenge_levels
        ORDER BY max_spending ASC
    </select>

</mapper>
