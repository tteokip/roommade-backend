<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.roommade.domain.house.mapper.HouseCommuteMapper">

    <select id="findWorkplaceAddressByUserId"
            resultType="com.roommade.domain.house.dto.response.WorkplaceAddressResponse">
        SELECT
            workplace_road_address
        FROM user_profiles
        WHERE user_id = #{userId}
    </select>

</mapper>
