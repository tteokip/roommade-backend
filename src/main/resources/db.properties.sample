# 이 파일을 db.properties 로 복사한 뒤 사용하세요.
# cp src/main/resources/db.properties.sample src/main/resources/db.properties
#
# 값이 비어 있거나 db.properties가 없어도 서버 기동 자체는 가능하며,
# 실제 DB 연결은 MyBatis 쿼리를 호출하는 시점에만 필요합니다.
#
# 아래 값은 docker-compose.yml + .env.sample이 만드는 로컬 MySQL 컨테이너의
# 애플리케이션 전용 계정(MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE)과 짝이 맞습니다.
# .env.sample을 바꿨다면 이 파일도 같이 맞춰주세요.

jdbc.driver=com.mysql.cj.jdbc.Driver
jdbc.url=jdbc:mysql://localhost:3306/roommade?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
jdbc.username=roommade
jdbc.password=roommade1234

# HikariCP connection pool
jdbc.pool.maximum-pool-size=10
jdbc.pool.minimum-idle=2
jdbc.pool.connection-timeout-ms=30000

# 금융감독원 금융상품 통합비교공시 API
fss.api.base-url=${FSS_API_BASE_URL:https://finlife.fss.or.kr}
fss.api.auth=${FSS_API_KEY}
fss.api.deposit-path=${FSS_DEPOSIT_PATH:/finlifeapi/depositProductsSearch.json}
fss.api.saving-path=${FSS_SAVING_PATH:/finlifeapi/savingProductsSearch.json}
fss.api.top-fin-grp-no=${FSS_TOP_FIN_GRP_NO:020000}
fss.api.financial-company-code=${FSS_FINANCIAL_COMPANY_CODE:0010927}
fss.api.sync-cron=0 0 3 * * *

# 온통 청년 Youth Policy API
youth-policy.api.base-url=${YOUTH_POLICY_API_BASE_URL:https://www.youthcenter.go.kr}
youth-policy.api.policy-path=${YOUTH_POLICY_PATH:/go/ythip/getPlcy}
youth-policy.api.key=${YOUTH_POLICY_API_KEY}
youth-policy.api.page-size=${YOUTH_POLICY_PAGE_SIZE:10}
youth-policy.api.sync-cron=0 10 3 * * *

# TMAP Open API (지오코딩 + 대중교통 경로, 매물 통근 시간 계산용)
tmap.api.key=${TMAP_API_KEY:}
